stateDiagram-v2
    direction TB
    classDef breaks fill:#ffecee,stroke:#e72e3b
    classDef notInDesign fill:#fff3e6,stroke:#e8730c
    state "요청 상태" as status {
        pending: 처음 대기 (열림)
        again: 다시 대기 (열림)
        success: 성공 (닫힘)
        retry: 실패 뒤 대기 (열림)
        rejected: 거절 (닫힘)
        deploying: 배포 중 (열림)
        superseded: 새 커밋에 밀림 (닫힘)
        [*] --> pending: 요청이 들어온다
        pending --> deploying: 승인해서 시도를 시작한다 [점검 필요가 없거나 승인 원천이 단건 승인 그리고 허가를 보낼 믿음 자리가 맞음]
        pending --> rejected: 거절한다
        pending --> superseded: 더 새 커밋이 들어온다
        pending --> success: 목표 커밋에 와 있다고 관측한다 [머리 셋이 같음 그리고 도는 시도 없음 그리고 실패한 노드 보고 없음 그리고 점검 필요 꺼짐]
        again --> deploying: 승인해서 시도를 시작한다 [점검 필요가 없거나 승인 원천이 단건 승인 그리고 허가를 보낼 믿음 자리가 맞음]
        again --> rejected: 거절한다
        again --> superseded: 더 새 커밋이 들어온다
        success --> success: 더 새 커밋이 들어온다
        retry --> deploying: 승인해서 시도를 시작한다 [점검 필요가 없거나 승인 원천이 단건 승인 그리고 허가를 보낼 믿음 자리가 맞음]
        retry --> rejected: 거절한다
        retry --> superseded: 더 새 커밋이 들어온다
        rejected --> rejected: 더 새 커밋이 들어온다
        deploying --> success: 시도가 성공으로 끝난다
        deploying --> superseded: 시도가 실패로 끝난다 [더 새 커밋이 있음]
        deploying --> retry: 시도가 실패로 끝난다 [더 새 커밋이 없음]
        deploying --> deploying: 더 새 커밋이 들어온다
        superseded --> superseded: 더 새 커밋이 들어온다
    }
