stateDiagram-v2
    direction TB
    classDef breaks fill:#ffecee,stroke:#e72e3b
    classDef mayBreak fill:#fff3e6,stroke:#e8730c
    state "요청 상태" as status {
        pending: 열림 · 처음 대기
        retry: 열림 · 표시 줄 있는 대기
        success: 닫힘 · 성공
        deploying: 열림 · 배포 중
        rejected: 닫힘 · 거절
        superseded: 닫힘 · 새 커밋에 밀림
        pending --> success: 더 새 관측이 자기 갱신을 닫는다 [자기 갱신 그리고 머리 셋이 같음 그리고 도는 시도 없음] (PR 2에서 바뀜)
        retry --> success: 더 새 관측이 자기 갱신을 닫는다 [자기 갱신 그리고 머리 셋이 같음 그리고 도는 시도 없음] (PR 2에서 바뀜)
        success --> rejected: 거절한다 (어긋남 8)
        deploying --> rejected: 거절한다 (어긋남 8)
        deploying --> retry: 노드가 자기 배포의 실패를 알린다 [표시 줄 있음] (PR 2에서 바뀜)
        deploying --> pending: 노드가 자기 배포의 실패를 알린다 [표시 줄 없음] (PR 2에서 바뀜)
        rejected --> rejected: 거절한다 (어긋남 8)
        rejected --> pending: 보류 시한이 지나 되살린다 [자기 갱신 그리고 보류 시한 지남 그리고 다른 열린 줄 없음] (PR 2에서 바뀜)
        superseded --> rejected: 거절한다 (어긋남 8)
    }
    class rejected breaks
