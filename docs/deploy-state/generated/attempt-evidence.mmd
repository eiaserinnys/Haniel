stateDiagram-v2
    direction TB
    classDef breaks fill:#ffecee,stroke:#e72e3b
    classDef notInDesign fill:#fff3e6,stroke:#e8730c
    state "종결 증거" as ev {
        state join1 <<join>>
        state join2 <<join>>
        state join3 <<join>>
        ev_none: 증거 아직 없음 (열림)
        ev_result: 성공 결과만 옴 (열림)
        ev_both: 성공으로 종결 (닫힘)
        ev_settled: 체크아웃 대조만 옴 (열림)
        ev_failed: 실패로 종결 (닫힘)
        ev_superseded: 노드의 배포 성공에 밀려 종결 (닫힘)
        [*] --> ev_none: 시도를 시작한다
        ev_none --> ev_result: 성공 결과가 온다 [execute 방식]
        ev_none --> ev_settled: 목표와 같은 대조가 온다 [execute 방식]
        ev_none --> ev_settled: 대조가 온다 [execute 방식 아님]
        ev_result --> ev_both: 목표와 같은 대조가 온다 [execute 방식]
        ev_settled --> ev_both: 성공 결과가 온다 [execute 방식]
        ev_none --> join1
        ev_result --> join1
        ev_settled --> join1
        join1 --> ev_failed: 실패로 닫는다
        ev_none --> join2
        ev_result --> join2
        ev_settled --> join2
        join2 --> ev_both: 증거 회수가 검증을 통과한다 [증거 회수 방식]
        ev_none --> join3
        ev_result --> join3
        ev_settled --> join3
        join3 --> ev_superseded: 노드의 배포 성공이 밀어낸다
    }
    class ev_superseded notInDesign
