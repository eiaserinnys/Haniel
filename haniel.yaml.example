# Full haniel configuration example — multi-service setup.
#
# Paths below use POSIX style (./runtime/venv/bin/python). On Windows, write the
# venv paths as ./runtime/venv/Scripts/python.exe and ./runtime/venv/Scripts/pip.exe.
#
# Directory structure (see docs/adr/0003-directory-structure.md):
#   {root}/
#   +-- haniel.yaml            <- this file
#   +-- logs/                  <- haniel.log and one <service>.log per service
#   +-- .self/                 <- haniel repo (self-update)
#   +-- .services/
#       +-- my-app/            <- cloned repo
#       +-- my-lib/            <- cloned repo
#
# Service logs go to <this file's folder>/logs/<service>.log, not into the
# service repository. Read them with the MCP tool haniel_read_logs.
#
# Check a copy of this file with `haniel validate haniel.yaml`. Unknown keys and
# unusable values (a misspelled key, ready: prt:80, an unknown signal name) make
# validate fail.

poll_interval: 60

# To use ${secret:NAME} references, create a dotenv file with NAME=value lines
# (for example WEBHOOK_URL and SLACK_BOT_TOKEN), uncomment the next line and the
# webhooks block below. A missing file or name stops the configuration from loading.
# secrets_file: .secrets/haniel.env

shutdown:
  timeout: 10
  kill_timeout: 30

backoff:
  base_delay: 5
  max_delay: 300
  circuit_breaker: 5
  circuit_window: 300

# webhooks:
#   - url: ${secret:WEBHOOK_URL}
#     format: slack

# Without this block the MCP server and the dashboard API are not started.
mcp:
  enabled: true
  host: 127.0.0.1
  port: 3200

repos:
  haniel:
    url: https://github.com/eiaserinnys/haniel.git
    branch: main
    path: ./.self

  my-app:
    url: git@github.com:org/my-app.git
    branch: main
    path: ./.services/my-app

  my-lib:
    url: git@github.com:org/my-lib.git
    branch: main
    path: ./.services/my-lib

# A self: block makes the systemd unit (Linux) or LaunchAgent (macOS) run
# haniel-runner.sh, and the Windows service run haniel-runner.ps1, so an
# approved self-update can pull and relaunch. Self-updates always wait for
# approval unless auto_update is true, whatever the global auto_apply says.
self:
  repo: haniel
  auto_update: false
  prepare_timeout: 3600

services:
  # MCP servers (no `after`, start in parallel)
  mcp-slack:
    run: npx -y supergateway --stdio "npx -y @anthropic/mcp-slack" --port 3101
    cwd: ./.services/my-app
    restart_delay: 3

  mcp-my-app:
    run: ./runtime/venv/bin/python -m my_app.mcp --port=3104
    cwd: ./.services/my-app
    repo: my-app
    ready: port:3104
    ready_timeout: 120
    restart_delay: 3
    hooks:
      post_pull: ./runtime/venv/bin/pip install -r ./.services/my-app/requirements.txt
      timeout: 900

  # Main service (starts once mcp-my-app is running and its ready condition holds)
  bot:
    run: ./runtime/venv/bin/python -m my_app.bot
    cwd: ./.services/my-app
    repo: my-app
    after: mcp-my-app
    shutdown:
      signal: SIGTERM
      timeout: 15
    hooks:
      post_pull: ./runtime/venv/bin/pip install -r ./.services/my-app/requirements.txt
      timeout: 900

install:
  requirements:
    python: ">=3.11"
    node: ">=18"
    winsw: true          # Windows only; skipped on Linux and macOS
    claude-code: true    # Needed only when the interactive phase has keys to collect

  directories:
    - ./.services
    - ./runtime
    - ./runtime/logs
    - ./runtime/data

  environments:
    main-venv:
      type: python-venv
      path: ./runtime/venv
      requirements:
        - ./.services/my-app/requirements.txt

    runtime-node:
      type: npm
      path: ./.services/my-app

  configs:
    app-env:
      path: ./.services/my-app/.env
      keys:
        - key: SLACK_BOT_TOKEN
          prompt: "Slack Bot Token (xoxb-...)"
          # validate runs before the .env file is written; {value} is pasted in as is,
          # so a value containing ' or $ can break the command.
          validate: "test -n '{value}'"
        - key: DEBUG
          default: "false"

    app-mcp:
      path: ./.services/my-app/.mcp.json
      content: |
        {
          "mcpServers": {
            "my-app-mcp": { "url": "http://localhost:3104/sse" },
            "haniel": { "url": "http://localhost:3200/mcp/" },
            "slack": { "url": "http://localhost:3101/sse" }
          }
        }

  service:
    name: haniel
    display: "Haniel Service Runner"
    working_directory: "{root}"
    environment:
      PYTHONUTF8: "1"
